---
/**
 * Visible placeholder for EPK sections that are still waiting on content.
 * Deliberately loud — nothing should ship to a promoter with these on the page.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  /** What's needed, in English — a note to the band, not to the press. */
  note: string;
}

const { note } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="pending">
  <span class="pending__tag">{t('epk.pending')}</span>
  <span class="pending__note">{note}</span>
</div>

<style>
  .pending {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed rgba(255, 176, 0, 0.5);
    border-radius: 4px;
    background: rgba(255, 176, 0, 0.04);
  }

  .pending__tag {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FFB000;
    white-space: nowrap;
  }

  .pending__note {
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
    font-style: italic;
  }
</style>
