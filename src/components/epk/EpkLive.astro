---
/**
 * Same source data as the homepage Gigs section, but rendered dense: a promoter
 * scanning an EPK wants the track record at a glance, not flyer artwork.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { upcomingGigs, pastGigs } from '../../data/gigs';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const now = new Date();
const upcoming = upcomingGigs(now);
const past = [...pastGigs(now)].reverse(); // most recent first for press

const fmt = (date: Date) =>
  new Intl.DateTimeFormat(lang, { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
---
<section class="epk-live" id="live">
  <div class="container">
    <p class="section-label">{t('epk.live.label')}</p>
    <h2 class="section-title">{t('epk.live.title')}</h2>
    <div class="neon-line"></div>

    <div class="epk-live__cols">
      <div>
        <h3 class="epk-live__kicker">{t('epk.live.upcoming')}</h3>
        {upcoming.length > 0 ? (
          <ul class="epk-live__list">
            {upcoming.map(gig => (
              <li>
                <span class="epk-live__date">{fmt(gig.date)}</span>
                <span class="epk-live__venue">
                  {gig.url
                    ? <a href={gig.url} target="_blank" rel="noopener">{gig.venue}</a>
                    : gig.venue}
                </span>
                <span class="epk-live__city">{t(gig.cityKey)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="epk-live__empty">{t('epk.live.empty')}</p>
        )}
      </div>

      <div>
        <h3 class="epk-live__kicker">{t('epk.live.past')}</h3>
        {past.length > 0 ? (
          <ul class="epk-live__list epk-live__list--past">
            {past.map(gig => (
              <li>
                <span class="epk-live__date">{fmt(gig.date)}</span>
                <span class="epk-live__venue">{gig.venue}</span>
                <span class="epk-live__city">{t(gig.cityKey)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="epk-live__empty">{t('epk.live.empty')}</p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .epk-live { background: var(--bg); }

  .epk-live__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .epk-live__kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pink);
    margin-bottom: var(--space-4);
  }

  .epk-live__list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .epk-live__list li {
    display: grid;
    grid-template-columns: 120px 1fr;
    grid-template-areas:
      'date venue'
      'date city';
    gap: 0 var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .epk-live__list--past li { opacity: 0.6; }

  .epk-live__date {
    grid-area: date;
    align-self: center;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    color: var(--cyan);
    white-space: nowrap;
  }

  .epk-live__venue {
    grid-area: venue;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    color: var(--white);
  }

  .epk-live__venue a { color: var(--white); }
  .epk-live__venue a:hover { color: var(--pink); }

  .epk-live__city {
    grid-area: city;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .epk-live__empty {
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .epk-live__cols { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
